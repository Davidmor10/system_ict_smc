# Economic calendar via Apify — macro feed in app/lib/news.ts
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored, so your token never gets committed. These are SERVER-ONLY vars:
# they are read in a Server Component and must NOT be prefixed NEXT_PUBLIC_,
# or Next.js would inline them into the browser bundle.

# Apify "Run Actor synchronously and get dataset items" endpoint, e.g.:
#   https://api.apify.com/v2/acts/<USER>~<ACTOR>/run-sync-get-dataset-items
# You can paste the URL exactly as the Apify console gives it — including a
# `?token=...` query param. If the token is in the URL, leave FF_CALENDAR_KEY blank.
FF_CALENDAR_URL=https://api.apify.com/v2/acts/USER~ACTOR/run-sync-get-dataset-items

# Apify API token. Only needed if it is NOT already embedded in FF_CALENDAR_URL.
# When set, it is appended to the request as `?token=...`.
FF_CALENDAR_KEY=
