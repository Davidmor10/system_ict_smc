# Economic calendar (Forex Factory intermediary) — macro feed in app/lib/news.ts
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored, so your key never gets committed. These are SERVER-ONLY vars:
# they are read in a Server Component and must NOT be prefixed NEXT_PUBLIC_,
# or Next.js would inline them into the browser bundle.

# Full endpoint of your provider's weekly calendar JSON.
FF_CALENDAR_URL=https://your-provider.example/api/ff_calendar_thisweek.json

# API key, if your provider requires one. Sent as the `X-API-Key` header.
# Leave blank for keyless feeds.
FF_CALENDAR_KEY=
