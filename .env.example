# ─────────────────────────────────────────────────────────────────────────────
# Environment template — copy to .env.local and fill in real values.
# NEVER commit real keys; .gitignore excludes every .env* except this file.
# In production (Vercel) set ALL of these in the project's Environment
# Variables — including for the Build step, so gated pages render dynamically.
# ─────────────────────────────────────────────────────────────────────────────

# Clerk (authentication)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase (database) — service-role key is server-only, bypasses RLS
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (billing) — one price ID per paid tier. Create three recurring
# prices in Stripe (₪49/mo Starter, ₪99/mo Pro, ₪199/mo Deluxe) and paste
# their `price_...` IDs below. Tier names must match app/lib/stripe/server.ts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_PRICE_STARTER=   # ₪49/mo  — unlocks the journal's AI Insight panel
STRIPE_PRICE_PRO=       # ₪99/mo  — adds the /dashboard/ai-analytics page
STRIPE_PRICE_DELUXE=    # ₪199/mo — adds the /dashboard/coach (AI Coach)

# AI providers
GEMINI_API_KEY=
GROQ_API_KEY=
# Claude — powers the nightly coach insight. Without it every insight silently
# falls back to Gemini Flash (the pipeline keeps working, quality drops).
ANTHROPIC_API_KEY=

# Coach pipeline — shared secret for /api/cron/*. Vercel Cron sends it as
# `Authorization: Bearer <value>`. REQUIRED: those routes fail closed with a
# 503 when it is unset, because an open cron endpoint is a public "spend my
# AI budget" button. Generate with: openssl rand -hex 32
CRON_SECRET=

# App
# Absolute origin of the deployed app, e.g. https://app.example.com —
# used for Stripe checkout return URLs.
NEXT_PUBLIC_APP_URL=
